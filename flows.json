    {
        "id": "e3d2a1f4e0464101",
        "type": "function",
        "z": "f2f001059f29ec6b",
        "name": "préparer influxDb",
        "func": "let data = msg.payload;\n\n// Conversion éventuelle du JSON texte en objet JavaScript\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch (error) {\n        node.error(\"Message JSON invalide : \" + error.message, msg);\n        return null;\n    }\n}\n\n// Conversion des mesures\nconst temperature = Number(data.temperature);\nconst humidity = Number(data.humidity);\nconst light = Number(data.light);\nconst presence = Number(data.presence);\nconst airQuality = Number(data.air_quality);\n\n// Vérification avant tout traitement\nif (\n    !Number.isFinite(temperature) ||\n    !Number.isFinite(humidity) ||\n    !Number.isFinite(light) ||\n    !Number.isFinite(presence) ||\n    !Number.isFinite(airQuality)\n) {\n    node.error(\n        \"Valeur numérique invalide : \" + JSON.stringify(data),\n        msg\n    );\n    return null;\n}\n\n// 0 = NORMAL\n// 1 = SURVEILLANCE\n// 2 = ALERTE\nlet etatCode = 0;\n\n// Température\nif (temperature > 40) {\n    etatCode = 2;\n} else if (temperature > 30) {\n    etatCode = Math.max(etatCode, 1);\n}\n\n// Humidité\nif (humidity < 30 || humidity > 80) {\n    etatCode = 2;\n} else if (humidity < 40 || humidity > 70) {\n    etatCode = Math.max(etatCode, 1);\n}\n\n// Luminosité simulée en valeur ADC\nif (light < 250 || light > 3500) {\n    etatCode = 2;\n} else if (light < 500 || light > 2500) {\n    etatCode = Math.max(etatCode, 1);\n}\n\n// Qualité de l'air simulée\nif (airQuality > 1200) {\n    etatCode = 2;\n} else if (airQuality > 800) {\n    etatCode = Math.max(etatCode, 1);\n}\n\n// Champs enregistrés dans InfluxDB\nconst fields = {\n    temperature: temperature,\n    humidity: humidity,\n    light: light,\n    presence: presence,\n    air_quality: airQuality,\n    etat_code: etatCode\n};\n\n// Tag d'identification\nconst tags = {\n    device_id: String(data.device_id || \"esp32_inconnu\")\n};\n\nmsg.payload = [fields, tags];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
